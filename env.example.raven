# ============================================================
# RAVEN PRO TRADING BOT - Environment Variables
# ============================================================

# Discord (Get token and channel ID from Raven Pro VIP)
# NOTE: For Telegram version, use main_raven_telegram.py instead
DISCORD_TOKEN=Bot YOUR_TOKEN
CHANNEL_ID=1234567890              # Raven Pro VIP Channel ID

# Telegram (for main_raven_telegram.py)
# Get API credentials from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
TELEGRAM_CHANNEL=@ravenpro          # Channel username (with @) or numeric ID
TELEGRAM_SESSION_STRING=            # Leave empty on first run (will be auto-generated)

# Bybit V5 (API key needs Futures permissions)
BYBIT_API_KEY=xxxxx
BYBIT_API_SECRET=xxxxx
BYBIT_TESTNET=false
BYBIT_DEMO=false                   # Paper trading mode

# Trading
CATEGORY=linear
QUOTE=USDT
LEVERAGE=10                        # Raven Pro uses 10x cross leverage

# Risk / Limits
RISK_PCT=5                         # Risk per trade in % (5% = aggressive, 2-3% = conservative)
MAX_CONCURRENT_TRADES=3           # Max 3 positions at once
MAX_TRADES_PER_DAY=20             # Safety limit

# Quantum Entry System (for entry zones)
USE_QUANTUM_ENTRY=true            # Use adaptive multi-layer entry
# If false, uses zone_mid as fixed entry price

# Quantum Entry Timeouts (seconds)
QUANTUM_ENTRY_PHASE1_TIMEOUT=90   # Patient phase (best prices)
QUANTUM_ENTRY_PHASE2_TIMEOUT=90   # Active phase (chase if needed)
QUANTUM_ENTRY_TOTAL_TIMEOUT=180   # Max total time (3 min default)
# Tip: Reduce for faster fills (60,60,120), increase for better prices (120,120,240)

# SL/TP behavior
INITIAL_SL_PCT=15.0               # Fallback if signal has no SL
MOVE_SL_TO_BE_ON_TP1=true         # Move SL to breakeven after TP1
BE_BUFFER_PCT=0.15                # Breakeven buffer (0.15% profit)

# Follow-TP: Progressive SL movement (FLEXIBLE!)
FOLLOW_TP_ENABLED=true            # Enable Follow-TP system
FOLLOW_TP_BUFFER_PCT=0.1          # Buffer for SL moves (0.1%)

# Follow-TP MODE: Choose strategy for when to move SL
FOLLOW_TP_MODE=custom             # Options: custom, skip_one, every_n, threshold

# MODE 1: "custom" (RECOMMENDED for Raven Pro) ⭐
# Move SL only on specific TPs you define
FOLLOW_TP_MOVE_ON_TPS=1,3         # Only TP1 and TP3 move SL
# Example with TP_SPLITS=50,20,15,10,0,5:
#   TP1 (50%) → SL to BE
#   TP2 (20%) → SKIP (no SL move)
#   TP3 (15%) → SL to TP1
#   TP4 (10%) → SKIP
#   TP6 (5%)  → SKIP
# Result: Runner (TP4+TP6=15%) runs with SL @ TP1 (safe!)

# MODE 2: "skip_one"
# Move SL only on odd TPs (TP1, TP3, TP5)
# FOLLOW_TP_MODE=skip_one
# Result: TP1 → BE, TP2 → skip, TP3 → TP1, TP4 → skip

# MODE 3: "every_n"
# Move SL every N TPs (configurable interval)
# FOLLOW_TP_MODE=every_n
# FOLLOW_TP_MOVE_INTERVAL=2       # Every 2nd TP (TP1, TP3, TP5)

# MODE 4: "threshold"
# Move SL only if fill >X% OR cumulative >Y%
# FOLLOW_TP_MODE=threshold
# FOLLOW_TP_MIN_FILL_PCT=15.0     # Min % fill to move SL
# FOLLOW_TP_CUMULATIVE_MIN=70.0   # OR cumulative >X% closed

# TP Splits for 6 TPs (Raven Pro has 6 TPs)
# Strategy: 50% @ TP1, 20% @ TP2, 15% @ TP3, 10% @ TP4, 5% @ TP6 (skip TP5)
TP_SPLITS=50,20,15,10,0,5         # Sum = 100%, no runner

# OR use auto-splits (equal distribution):
# TP_SPLITS_AUTO=true              # 6 TPs = 16.67% each

# Fallback TPs if signal has none (should not happen with Raven Pro)
FALLBACK_TP_PCT=0.85,1.65,2.5,3.5,4.5,5.5

# DCA (Raven Pro doesn't use DCAs, but keep for compatibility)
DCA_QTY_MULTS=1.5

# Filters
MAX_SL_DISTANCE_PCT=25            # Skip signals with SL > 25% from entry
MIN_SIGNAL_LEVERAGE=0             # No leverage filter (Raven uses 10x)

# Polling Discord
POLL_SECONDS=15
TC_MAX_LAG_SEC=300                # Ignore signals older than 5 minutes
SIGNAL_UPDATE_INTERVAL_SEC=15     # Check for signal updates every 15s

# Logging / Safety
DRY_RUN=false                     # Set to true for testing (no real trades)
LOG_LEVEL=INFO

# Optional: Telegram Alerts
# TELEGRAM_BOT_TOKEN=xxxxx
# TELEGRAM_CHAT_ID=xxxxx
# POSITION_ALERT_THRESHOLDS=25,35,50    # Alert at -25%, -35%, -50% P&L

# Optional: PostgreSQL Database (for Dashboard)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Bot ID (for multi-bot setup)
BOT_ID=raven                      # Unique identifier for this bot
